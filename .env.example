# ================================================================
# Solare — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# No Vercel: Project Settings → Environment Variables
# ================================================================

# ── Site ─────────────────────────────────────────────────────────
# URL completa do seu site (sem barra final)
SITE_URL=https://seudominio.com.br

# ── Supabase ─────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Mercado Pago ─────────────────────────────────────────────────
# mercadopago.com.br → Suas integrações → Credenciais
# Produção:
MP_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx-xxxx-xxxx-xxxx
# Webhook secret (gerado ao configurar o webhook no MP):
MP_WEBHOOK_SECRET=xxxx

# ── Email (Resend) ────────────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxx
# E-mail remetente (precisa estar verificado no Resend)
FROM_EMAIL=pedidos@seudominio.com.br

# ── SMS (Twilio) — opcional ───────────────────────────────────────
# twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_FROM=+1xxxxxxxxxx

# ── WhatsApp de suporte ───────────────────────────────────────────
# Número sem +55 e sem formatação (ex: 11999999999)
WHATSAPP_NUMBER=11999999999

# ── Meta Pixel (opcional) ─────────────────────────────────────────
# facebook.com/events → Gerenciar → Configurações → Conversions API
META_PIXEL_TOKEN=EAAxxxxxxxxxxxxxxxxxx
