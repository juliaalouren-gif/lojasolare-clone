# ================================================================
# Solare — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# No Vercel: Project Settings → Environment Variables
# ================================================================

# ── Site ─────────────────────────────────────────────────────────
# URL completa do seu site (sem barra final)
SITE_URL=https://seudominio.com.br

# ── Supabase ─────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Mercado Pago (gateway ativo) ──────────────────────────────────
# Painel MP → Suas integrações → aplicação "Checkout Transparente" (API de Payments)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Assinatura HMAC do webhook (header x-signature) — não é query string como na Pagar.me
MP_WEBHOOK_SECRET=xxxx

# ── Pagar.me / Stone (gateway anterior — lib/pagarme.js e api/pagarme-*.js
# ficaram no repo sem uso, só pra rollback rápido se precisar) ─────
# Painel Pagar.me/Stone → Configurações da conta → Chaves de API
PAGARME_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxx
PAGARME_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxx
# A Pagar.me não assina webhooks por HMAC — a URL configurada no painel
# carrega esse segredo como query string:
# https://seudominio.com.br/api/pagarme-webhook?secret=SEU_SEGREDO_AQUI
PAGARME_WEBHOOK_SECRET=xxxx

# ── SuperFrete (geração de etiqueta + rastreio) ───────────────────
# web.superfrete.com → Integrações → Desenvolvedores → gerar token
SUPERFRETE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Gerado automaticamente ao cadastrar o webhook (ver scripts/registrar
# webhook da SuperFrete) — usado pra validar a assinatura HMAC recebida.
SUPERFRETE_WEBHOOK_SECRET=xxxx

# ── Brevo (e-mails transacionais + automação de marketing) ────────
# app.brevo.com → SMTP & API → API Keys
# IMPORTANTE: em Configurações → Segurança → IPs autorizados, desative a
# restrição para "Chaves API" (a Vercel não tem IP fixo).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remetente verificado em app.brevo.com → Remetentes, domínios, IPs
BREVO_SENDER_EMAIL=pedidos@seudominio.com.br
BREVO_SENDER_NAME=Solare

# ── SMS (Twilio) — opcional ───────────────────────────────────────
# twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_FROM=+1xxxxxxxxxx

# ── WhatsApp de suporte ───────────────────────────────────────────
# Número sem +55 e sem formatação (ex: 11999999999)
WHATSAPP_NUMBER=11999999999

# ── Meta Pixel (opcional) ─────────────────────────────────────────
# facebook.com/events → Gerenciar → Configurações → Conversions API
META_PIXEL_TOKEN=EAAxxxxxxxxxxxxxxxxxx
